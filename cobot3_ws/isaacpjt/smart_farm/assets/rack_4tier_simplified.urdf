<?xml version="1.0"?>
<!--
  Simplified five-tier rack for the smart-farm scene.
  Units: meters. rack_link origin: floor at rack center (X=Y=Z=0).
  The attached rack.usd references an unavailable external mesh, so horizontal
  dimensions below are adjustable approximations, not measured source geometry.
  Shelf top heights: 0.7129, 1.0129, 1.3129, 1.6129, 1.9129 m.
  Change the link pose in the scene to place the rack; these are local heights.
  In Isaac Sim, import as a fixed-base/static object.
-->
<robot name="rack_5tier_simplified">
  <link name="rack_link">
    <!-- Five 1.00 x 0.60 m shelves, 0.025 m thick. -->
    <visual name="shelf_1_visual">
      <origin xyz="0 0 0.7004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
      <material name="shelf_gray"><color rgba="0.64 0.67 0.70 1"/></material>
    </visual>
    <collision name="shelf_1_collision">
      <origin xyz="0 0 0.7004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
    </collision>
    <visual name="shelf_2_visual">
      <origin xyz="0 0 1.0004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
      <material name="shelf_gray"/>
    </visual>
    <collision name="shelf_2_collision">
      <origin xyz="0 0 1.0004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
    </collision>
    <visual name="shelf_3_visual">
      <origin xyz="0 0 1.3004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
      <material name="shelf_gray"/>
    </visual>
    <collision name="shelf_3_collision">
      <origin xyz="0 0 1.3004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
    </collision>
    <visual name="shelf_4_visual">
      <origin xyz="0 0 1.6004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
      <material name="shelf_gray"/>
    </visual>
    <collision name="shelf_4_collision">
      <origin xyz="0 0 1.6004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
    </collision>
    <visual name="shelf_5_visual">
      <origin xyz="0 0 1.9004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
      <material name="shelf_gray"/>
    </visual>
    <collision name="shelf_5_collision">
      <origin xyz="0 0 1.9004" rpy="0 0 0"/>
      <geometry><box size="1.00 0.60 0.025"/></geometry>
    </collision>
    <!-- Corner posts: 0.04 x 0.04 m; top at 1.97 m. -->
    <visual name="post_front_left_visual">
      <origin xyz="-0.48 -0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
      <material name="post_blue"><color rgba="0.18 0.29 0.39 1"/></material>
    </visual>
    <collision name="post_front_left_collision">
      <origin xyz="-0.48 -0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
    </collision>
    <visual name="post_front_right_visual">
      <origin xyz="-0.48 0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
      <material name="post_blue"/>
    </visual>
    <collision name="post_front_right_collision">
      <origin xyz="-0.48 0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
    </collision>
    <visual name="post_rear_left_visual">
      <origin xyz="0.48 -0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
      <material name="post_blue"/>
    </visual>
    <collision name="post_rear_left_collision">
      <origin xyz="0.48 -0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
    </collision>
    <visual name="post_rear_right_visual">
      <origin xyz="0.48 0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
      <material name="post_blue"/>
    </visual>
    <collision name="post_rear_right_collision">
      <origin xyz="0.48 0.28 0.985" rpy="0 0 0"/>
      <geometry><box size="0.04 0.04 1.97"/></geometry>
    </collision>
  </link>
  <gazebo><static>true</static></gazebo>
</robot>
