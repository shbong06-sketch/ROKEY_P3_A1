#usda 1.0
(
    defaultPrim = "Lettuce"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Lettuce"
{
    def Cube "Body" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        rel material:binding = </Lettuce/Looks/Mat>
        double size = 1
        float3 xformOp:scale = (0.12, 0.12, 0.1)
        double3 xformOp:translate = (0, 0, 0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def "Looks"
    {
        def Material "Mat"
        {
            token outputs:surface.connect = </Lettuce/Looks/Mat/PreviewSurface.outputs:surface>

            def Shader "PreviewSurface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.38, 0.22, 0.08)
                float inputs:metallic = 0
                float inputs:roughness = 0.7
                token outputs:surface
            }
        }
    }
}

