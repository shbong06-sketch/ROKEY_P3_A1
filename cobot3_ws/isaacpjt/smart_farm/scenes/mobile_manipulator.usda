#usda 1.0
(
    defaultPrim = "mobile_manipulator"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "mobile_manipulator" (
    doc = "MiR100 + Doosan M0617 + OnRobot RG6 mobile manipulator. Robot asset only: reference/drag into any stage. Contains no PhysicsScene, ground or lights. Recommended scene physics rate: 240 Hz."
    kind = "assembly"
)
{
    quatf xformOp:orient = (1, 0, 0, 0)
    float3 xformOp:scale = (1, 1, 1)
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

    def Xform "mir100" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        prepend references = @../assets/mir100.usd@
    )
    {
        int physxArticulation:solverPositionIterationCount = 16
        int physxArticulation:solverVelocityIterationCount = 1
    }

    def Xform "m0617" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        prepend references = @../assets/m0617_rebuilt.usd@
    )
    {
        int physxArticulation:solverPositionIterationCount = 32
        int physxArticulation:solverVelocityIterationCount = 1
        double3 xformOp:translate = (0, 0, 0.3942)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "rg6" (
        prepend apiSchemas = ["PhysxArticulationAPI"]
        prepend references = @../assets/rg6_gripper.usd@
    )
    {
        int physxArticulation:solverPositionIterationCount = 16
        int physxArticulation:solverVelocityIterationCount = 1
        quatf xformOp:orient = (0.99999994, -2.942729e-8, 0.00024409404, -0.0002441872)
        double3 xformOp:translate = (0.00017420973481601713, 0.03484625259504538, 2.2471999469987103)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
    }

    def Scope "joints"
    {
        def PhysicsFixedJoint "mir100_to_m0617" (
            doc = "MiR100 base_footprint -> M0617 base_link. localPos0 z=0.3942 = MiR100 top plate 0.349 + M0617 base bottom offset 0.0452 (from geometry; replace with CAD value)."
        )
        {
            rel physics:body0 = </mobile_manipulator/mir100/base_footprint>
            rel physics:body1 = </mobile_manipulator/m0617/base_link>
            uniform bool physics:excludeFromArticulation = 1
            point3f physics:localPos0 = (0, 0, 0.3942)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "m0617_to_rg6" (
            doc = "M0617 link_6 (flange) -> RG6 base_link, identity (RG6 +Z = tool axis). Replace with CAD value if an adapter plate is used."
        )
        {
            rel physics:body0 = </mobile_manipulator/m0617/link_6>
            rel physics:body1 = </mobile_manipulator/rg6/base_link>
            uniform bool physics:excludeFromArticulation = 1
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

