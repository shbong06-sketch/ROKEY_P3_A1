<?xml version="1.0" ?>
<!--
  mir100.urdf — /mnt/user-data/uploads/mir100.usd 를 직접 파싱해 확인한 실측치로 작성.

  [확인된 사실 그대로 반영한 것]
  - 링크 구성: base_footprint(루트) + left/right_wheel_link + 4x caster_rotation_link + 4x caster_wheel_link
    (USD에 base_link라는 별도 프림은 없고 base_footprint가 곧 루트 바디임)
  - 모든 조인트의 origin(xyz)은 PhysicsRevoluteJoint의 localPos0을 그대로 사용(localRot0/1은 전부
    identity 쿼터니언이라 rpy=0 0 0으로 반영)
  - 구동휠(left/right_wheel_joint): axis Y, continuous, effort=200(N·m, USD drive:angular:physics:maxForce
    실측), 반지름 0.0625m/폭 0.032m(USD Cylinder 실측)
  - 캐스터 회전 조인트(axis Z)·캐스터 휠 조인트(axis Y): USD에 PhysicsDriveAPI 자체가 없음(순수 수동
    캐스터) → effort=0으로 반영
  - 질량: base_footprint=79.4kg, 구동휠/캐스터휠=1.0kg, 캐스터 회전브라켓=0.30975kg (전부 USD MassAPI 실측)
  - base_footprint 몸체 치수는 USD Mesh의 extent(바운딩박스)로 근사한 box — 실제 비주얼 메쉬 파일(dae/obj)이
    이 업로드에 포함돼 있지 않아 정확한 외형 대신 바운딩박스 근사치를 사용함(주석 처리된 실측 extent 참고)
  - front/back 라이다 하우징은 base_footprint 밑에 별도 조인트 없는 서브메쉬로만 존재해 URDF에서는
    base_footprint의 추가 visual/collision 요소로만 반영(별도 링크로 분리하지 않음)

  [계산/추정치 — USD에 없어서 새로 만든 값, 반드시 확인 후 사용]
  - <inertial> 관성텐서: USD MassAPI의 diagonalInertia가 전부 (0,0,0)으로 비어있어(PhysX 런타임 자동계산
    방식) URDF 규격상 요구되는 관성값을 여기서 새로 계산함. base_footprint는 박스, 바퀴는 실린더, 캐스터
    브라켓은 근사 구(sphere)로 가정한 표준 공식 계산치이며, 실제 질량 분포와 다를 수 있음.
  - 구동휠 velocity 리밋: USD에 조인트 속도 상한이 authored되어 있지 않아(PhysX 쪽은 damping/maxForce만
    있음) URDF 요구사항을 충족하기 위한 보수적 placeholder(10 rad/s)를 넣음 — 실제 사양으로 교체 권장.
  - 시각/충돌 지오메트리는 실제 메쉬가 아니라 extent 기반 box/cylinder/sphere 근사치.
-->
<robot name="mir100">

  <link name="base_footprint">
    <inertial>
      <!-- box 근사: x=0.898, y=0.585, z=0.334 (USD collision mesh extent 기준), origin z=0.187 -->
      <origin xyz="0 0 0.187" rpy="0 0 0"/>
      <mass value="79.4"/>
      <inertia ixx="2.996" ixy="0.0" ixz="0.0" iyy="6.074" iyz="0.0" izz="7.594"/>
    </inertial>

    <!-- 본체 (USD visual_base_link_0 extent 근사 box: min(-0.4494,-0.2916,0.0197) max(0.4489,0.2927,0.3540)) -->
    <visual>
      <origin xyz="0 0 0.187" rpy="0 0 0"/>
      <geometry>
        <box size="0.898 0.584 0.334"/>
      </geometry>
    </visual>
    <collision>
      <!-- USD collision_base_link_0 extent 근사 (z 시작이 visual보다 약간 높음: 0.048) -->
      <origin xyz="0 0 0.201" rpy="0 0 0"/>
      <geometry>
        <box size="0.898 0.584 0.306"/>
      </geometry>
    </collision>

    <!-- 전방 라이다 하우징 (USD visual_front_laser_link_0 extent 근사, base_footprint 로컬 좌표) -->
    <visual>
      <origin xyz="-0.0123 0.0001 -0.0396" rpy="0 0 0"/>
      <geometry>
        <box size="0.126 0.102 0.152"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0123 0.0001 -0.0396" rpy="0 0 0"/>
      <geometry>
        <box size="0.126 0.102 0.152"/>
      </geometry>
    </collision>

    <!-- 후방 라이다 하우징 (USD상 extent가 전방과 동일값으로 확인됨 — 실제 위치가 다르면 y/x 부호만 대칭
         이동 필요, 이번 확인 범위에서는 개별 오프셋을 분리하지 못해 동일 좌표로 둠: 확인 필요) -->
    <visual>
      <origin xyz="-0.0123 0.0001 -0.0396" rpy="0 0 0"/>
      <geometry>
        <box size="0.126 0.102 0.152"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="-0.0123 0.0001 -0.0396" rpy="0 0 0"/>
      <geometry>
        <box size="0.126 0.102 0.152"/>
      </geometry>
    </collision>
  </link>

  <!-- ===================== 구동휠 (좌/우) ===================== -->

  <link name="left_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0625" length="0.032"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0625" length="0.032"/>
      </geometry>
    </collision>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="left_wheel_link"/>
    <!-- localPos0 실측: (0, 0.222604, 0.0625) -->
    <origin xyz="0 0.222604 0.0625" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="right_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0625" length="0.032"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.0625" length="0.032"/>
      </geometry>
    </collision>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="right_wheel_link"/>
    <!-- localPos0 실측: (0, -0.222604, 0.0625) -->
    <origin xyz="0 -0.222604 0.0625" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="200" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <!-- ===================== 캐스터 4개 (fl/fr/bl/br) =====================
       구조: base_footprint -> *_caster_rotation_link(축 Z, 자유 회전, 수동)
             -> *_caster_wheel_link(축 Y, 자유 회전, 수동)
       회전 브라켓 오프셋(z=-0.094, x=-0.0382)은 4개 전부 USD에서 동일값으로 확인됨. -->

  <link name="fl_caster_rotation_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30975"/>
      <inertia ixx="0.0001115" ixy="0.0" ixz="0.0" iyy="0.0001115" iyz="0.0" izz="0.0001115"/>
    </inertial>
  </link>
  <joint name="fl_caster_rotation_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="fl_caster_rotation_link"/>
    <origin xyz="0.341346 0.203 0.1565" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="fl_caster_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </collision>
  </link>
  <joint name="fl_caster_wheel_joint" type="continuous">
    <parent link="fl_caster_rotation_link"/>
    <child link="fl_caster_wheel_link"/>
    <origin xyz="-0.0382 0 -0.094" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="fr_caster_rotation_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30975"/>
      <inertia ixx="0.0001115" ixy="0.0" ixz="0.0" iyy="0.0001115" iyz="0.0" izz="0.0001115"/>
    </inertial>
  </link>
  <joint name="fr_caster_rotation_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="fr_caster_rotation_link"/>
    <origin xyz="0.341346 -0.203 0.1565" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="fr_caster_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </collision>
  </link>
  <joint name="fr_caster_wheel_joint" type="continuous">
    <parent link="fr_caster_rotation_link"/>
    <child link="fr_caster_wheel_link"/>
    <origin xyz="-0.0382 0 -0.094" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="bl_caster_rotation_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30975"/>
      <inertia ixx="0.0001115" ixy="0.0" ixz="0.0" iyy="0.0001115" iyz="0.0" izz="0.0001115"/>
    </inertial>
  </link>
  <joint name="bl_caster_rotation_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="bl_caster_rotation_link"/>
    <origin xyz="-0.270154 0.203 0.1565" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="bl_caster_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </collision>
  </link>
  <joint name="bl_caster_wheel_joint" type="continuous">
    <parent link="bl_caster_rotation_link"/>
    <child link="bl_caster_wheel_link"/>
    <origin xyz="-0.0382 0 -0.094" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="br_caster_rotation_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.30975"/>
      <inertia ixx="0.0001115" ixy="0.0" ixz="0.0" iyy="0.0001115" iyz="0.0" izz="0.0001115"/>
    </inertial>
  </link>
  <joint name="br_caster_rotation_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="br_caster_rotation_link"/>
    <origin xyz="-0.270154 -0.203 0.1565" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <link name="br_caster_wheel_link">
    <inertial>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.001062" ixy="0.0" ixz="0.0" iyy="0.001062" iyz="0.0" izz="0.001953"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.0625" length="0.032"/></geometry>
    </collision>
  </link>
  <joint name="br_caster_wheel_joint" type="continuous">
    <parent link="br_caster_rotation_link"/>
    <child link="br_caster_wheel_link"/>
    <origin xyz="-0.0382 0 -0.094" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0" velocity="10.0"/>
    <dynamics friction="0" damping="0"/>
  </joint>

  <!-- ===================== 호환용 가상 프레임 (TF 트리 보강) ===================== -->
  <!-- 1) base_link: base_footprint와 동등한 베이스 프레임 제공 -->
  <link name="base_link"/>
  <joint name="base_footprint_to_base_link_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 2) LiDAR 프레임들: Isaac Sim LaserScan frame_id 호환 -->
  <link name="front_laser_link"/>
  <joint name="base_footprint_to_front_laser_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="front_laser_link"/>
    <origin xyz="0.42 0.23 0.18" rpy="0 0 0.785398"/>
  </joint>

  <link name="front_laser"/>
  <joint name="base_footprint_to_front_laser_alias_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="front_laser"/>
    <origin xyz="0.42 0.23 0.18" rpy="0 0 0.785398"/>
  </joint>

  <link name="back_laser_link"/>
  <joint name="base_footprint_to_back_laser_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="back_laser_link"/>
    <origin xyz="-0.42 -0.23 0.18" rpy="0 0 -2.356194"/>
  </joint>

  <link name="laser_frame"/>
  <joint name="base_footprint_to_laser_frame_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="laser_frame"/>
    <origin xyz="0.42 0.0 0.18" rpy="0 0 0"/>
  </joint>

  <link name="scan"/>
  <joint name="base_footprint_to_scan_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="scan"/>
    <origin xyz="0.42 0.0 0.18" rpy="0 0 0"/>
  </joint>

</robot>
