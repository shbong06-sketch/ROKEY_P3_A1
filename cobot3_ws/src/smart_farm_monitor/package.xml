<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>smart_farm_monitor</name>
  <version>0.0.0</version>
  <description>
    스마트팜 공정 기록(SQLite)과 관제 웹 서비스. recorder 노드가 토픽을 받아
    기록하고, 웹은 같은 DB 파일을 읽기 전용으로 조회한다.
  </description>
  <maintainer email="codesorryy@gmail.com">lwh</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>smart_farm_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <exec_depend>ros2launch</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>ament_pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
